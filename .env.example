# Turnos Odontología — env vars (copiar a .env y completar)
# Ver knowledge-base/08_arquitectura_propuesta.md §Variables de entorno

DB_HOST=mysql
DB_PORT=3306
DB_NAME=turnos_db
DB_USER=turnos_user
DB_PASSWORD=changeme

APP_SECRET=changeme-dev-secret-32-chars-min
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_TURNO_DURACION_MIN=30
APP_HORARIO_DESDE=08:00
APP_HORARIO_HASTA=18:00
APP_ENV=dev
APP_LOG_LEVEL=INFO
PORT=8080

# MySQL root (solo docker-compose local)
MYSQL_ROOT_PASSWORD=changeme_root
